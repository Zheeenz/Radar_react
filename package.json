  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "dev": "node scripts/dev.mjs",
    "dev:web": "node scripts/dev.mjs --web",
    "server": "node backend/server.mjs",
    "server:lan": "node scripts/server-lan.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.mjs test/*.test.ts",
    "test:web": "playwright test",
    "build:web": "expo export --platform web",
    "build:native": "expo export --platform android --platform ios --output-dir dist-native",
